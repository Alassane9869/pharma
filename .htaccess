# ============================================
# CONFIGURATION APACHE O2SWITCH / CPANEL
# ============================================

# Activation de la réécriture d'URL
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirection automatique EXCLUSIVE au sous-domaine souley-guirou
    # NE JAMAIS REDIRIGER LE DOMAINE PRINCIPAL danayaplus.com
    RewriteCond %{HTTP_HOST} ^(www\.)?souley-guirou\.danayaplus\.com$ [NC]
    RewriteCond %{REQUEST_URI} !^/pharmacie-gestion/
    RewriteRule ^$ pharmacie-gestion/ [L,R=302]
</IfModule>
