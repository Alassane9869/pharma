# ============================================
# CONFIGURATION APACHE O2SWITCH / CPANEL
# ============================================

# Activation de la réécriture d'URL
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirection automatique vers la racine de l'application
    RewriteCond %{REQUEST_URI} !^/pharmacie-gestion/
    RewriteRule ^$ pharmacie-gestion/ [L,R=301]
</IfModule>
